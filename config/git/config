[color]
  ui = true
[core]
  editor = vim
  quotepath = false
  excludesfile =  ~/.gitignore
[diff]
  tool = vimdiff
[status]
  short = true
[fetch]
  # Delete local branches that are deleted remotely
  prune = true
[alias]
  tree = log --graph --decorate --oneline --abbrev-commit
  # Delete local branches that are already merged to master
  cleanup = "!git branch --merged | grep  -v '\\*\\|master\\|develop' | xargs -n 1 git branch -d"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	format = ssh
[gpg "ssh"]
	# Plain ssh-keygen signs via whatever agent SSH_AUTH_SOCK points at:
	# 1Password locally, or the forwarded agent over SSH (op-ssh-sign only
	# ever prompts on the local desktop, which hangs remote sessions).
	program = ssh-keygen
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
[url "git@github.snooguts.net:"]
	insteadOf = https://github.snooguts.net
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
